# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Grab both from the Neon dashboard → Connection Details.
# DATABASE_URL uses the POOLED host (…-pooler…); the app connects with this.
# DATABASE_URL_DIRECT is the same string WITHOUT "-pooler" (direct connection),
# used by drizzle-kit for DDL/migrations. Leave it blank to fall back to DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (no trailing slash). Dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ─── Dev-only login convenience ──────────────────────────────────────────────
# Pre-fills the login form in development. NEVER set these in production.
DEV_LOGIN_EMAIL=test@example.com
DEV_LOGIN_PASSWORD=password1234

# ─── Google Generative AI (Gemini) ───────────────────────────────────────────
# Used by the AI bean-scan feature. https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Resend (transactional email) ────────────────────────────────────────────
# https://resend.com/api-keys
# With an unverified domain, only onboarding@resend.dev can send, and only to
# the Resend account's own email. Verify a domain to email real users.
RESEND_API_KEY=
EMAIL_FROM=Brew.log <onboarding@resend.dev>

# ─── Google OAuth (social sign-in) ───────────────────────────────────────────
# GCP Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# (dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Upstash Redis (auth rate-limit storage) ─────────────────────────────────
# https://console.upstash.com → create a database → REST API section.
# Backs Better Auth's rate limiter so limits are shared across serverless
# instances (the default in-memory store resets per invocation). Free tier is
# plenty for this app.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
